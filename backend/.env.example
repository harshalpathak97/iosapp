# Copy this file to .env and fill in real values. Never commit .env to git.

# Port the backend listens on.
PORT=3000

# Shared secret the iOS app must send as `Authorization: Bearer <secret>`.
# Generate something long and random.
API_SHARED_SECRET=change-me-to-a-long-random-string

# LinkedIn session cookie. Required for scraping.
# How to get it:
#   1. Log into linkedin.com in Chrome (use a dedicated LinkedIn account for this -- it
#      will get rate-limited and possibly banned).
#   2. Open DevTools (Cmd-Opt-I) > Application > Cookies > https://www.linkedin.com
#   3. Find the cookie named `li_at`, copy its Value
#   4. Paste below.
# Note: this cookie is long-lived but will eventually expire or be invalidated by LinkedIn.
LINKEDIN_LI_AT_COOKIE=

# Optional: path to a custom Chrome/Chromium binary. Leave blank to use Puppeteer's bundled one.
PUPPETEER_EXECUTABLE_PATH=
